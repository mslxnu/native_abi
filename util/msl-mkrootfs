#!/bin/sh
#
# Build a Debian rootfs for NABI by downloading it from the Debian archive.
#
#   msl-mkrootfs [-s suite] [-a arch] [-m mirror] [-i pkg,pkg] [-v variant] <dir>
#
# This is debootstrap's shape, done with what macOS ships and finished inside
# NABI itself. There are three stages and the third is the interesting one.
#
#   1. Resolve.  Fetch the archive's Packages index and walk Depends and
#      Pre-Depends from the required/essential floor to a closure. Recommends
#      is not followed; it is the difference between a 90-package base and a
#      900-package one.
#
#   2. Unpack.   Download each .deb, check it against the SHA256 the index
#      gives, and lay down its data.tar and its control members - the file
#      list, the md5sums, and the maintainer scripts. Everything is recorded
#      as "unpacked", not "installed", because at this point it is true.
#
#   3. Configure. Run `dpkg --configure -a` in the tree, under NABI. This is
#      debootstrap's second stage, and until NABI could run dpkg there was no
#      way to do it on macOS at all: the maintainer scripts are aarch64 shell
#      and need a working guest to execute, which is the thing being built.
#      Skipping it is what left the earlier ISO-based tree without /etc/shadow,
#      without an ld.so cache, and without any update-alternatives symlink.
#
# What is verified: the archive is fetched over https, the Packages index is
# checked against the SHA256 in the suite's Release file, and every .deb is
# checked against the SHA256 in that index. What is not verified is Release's
# OpenPGP signature - macOS ships no gpgv - so the trust root here is TLS and
# the Debian CA chain rather than the archive key. Once the tree exists, apt
# inside it does check signatures, with the keyring this installs.
set -eu

DISTRO=debian
SUITE=
ARCH=arm64
MIRROR=
EXTRA=
VARIANT=standard

# Per-distro defaults, and which of the three shapes each one is.
#
#   apt  debian, ubuntu - an archive of packages with a dependency graph. The
#        base system has to be resolved out of it and then configured, which is
#        what debootstrap does and what stages 1 to 3 below do.
#   oci  fedora         - a published container image: an OCI layout holding a
#        manifest and one or more filesystem layers, already complete.
#   tar  arch           - a published rootfs tarball, already complete.
#
# The last two are much less work precisely because somebody else did the
# resolving. What they cost instead is a trust root: their content is whatever
# the project published, taken on the strength of a checksum served beside it.
distro_defaults() {
    case $1 in
        debian)
            FAMILY=apt
            : "${SUITE:=trixie}"
            : "${MIRROR:=https://deb.debian.org/debian}"
            KEYRING=debian-archive-keyring
            SECURITY="deb https://security.debian.org/debian-security $SUITE-security main"
            ;;
        ubuntu)
            FAMILY=apt
            : "${SUITE:=noble}"
            # ports/ is the arm64 archive; archive.ubuntu.com carries amd64 only.
            : "${MIRROR:=https://ports.ubuntu.com/ubuntu-ports}"
            KEYRING=ubuntu-keyring
            SECURITY="deb $MIRROR $SUITE-security main universe"
            ;;
        fedora)
            FAMILY=oci
            : "${SUITE:=43}"
            : "${MIRROR:=https://dl.fedoraproject.org/pub/fedora/linux/releases}"
            IMAGES="$MIRROR/$SUITE/Container/aarch64/images"
            ;;
        arch)
            FAMILY=tar
            # Arch Linux ARM's own host has no certificate for its name, so the
            # default is a mirror that does - the download is the trust root
            # here and http would leave nothing holding it up. Its checksum is
            # an md5 served beside the file, which catches a corrupt transfer
            # and is worth exactly nothing against a hostile one; TLS is what
            # is actually being relied on.
            : "${SUITE:=latest}"
            : "${MIRROR:=https://de3.mirror.archlinuxarm.org/os}"
            ARCHIVE="ArchLinuxARM-aarch64-$SUITE.tar.gz"
            ;;
        *)
            echo "${0##*/}: unknown distro: $1" >&2
            echo "  known: debian, ubuntu, fedora, arch" >&2
            exit 2
            ;;
    esac
}

usage() {
    cat >&2 <<EOM
usage: ${0##*/} [options] <target-dir>

  -d <distro>   debian, ubuntu, fedora or arch (default: $DISTRO)
  -s <suite>    suite, release or tag (trixie / noble / 43 / latest)
  -a <arch>     dpkg architecture (default: $ARCH)
  -m <mirror>   archive to fetch from (default: the distro's)
  -i <p,p,...>  extra packages to include
  -v <variant>  minbase (required only) or standard (adds Priority: important)
                (default: $VARIANT)
EOM
    exit 2
}

while getopts d:s:a:m:i:v:h opt; do
    case $opt in
        d) DISTRO=$OPTARG ;;
        s) SUITE=$OPTARG ;;
        a) ARCH=$OPTARG ;;
        m) MIRROR=$OPTARG ;;
        i) EXTRA=$OPTARG ;;
        v) VARIANT=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
ROOT=$1

distro_defaults "$DISTRO"

case $VARIANT in
    minbase|standard) ;;
    *) echo "${0##*/}: unknown variant: $VARIANT" >&2; exit 2 ;;
esac

# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------

for t in curl gunzip tar ar awk shasum; do
    command -v "$t" > /dev/null || { echo "${0##*/}: need $t" >&2; exit 1; }
done

# Refused rather than warned about, because the damage is silent. Debian ships
# files whose names differ only in case - manpages-dev has _exit.2.gz and
# _Exit.2.gz, linux-libc-dev has xt_connmark.h and xt_CONNMARK.h - and on a
# case-insensitive filesystem the second of each pair quietly overwrites the
# first. The tree that comes out looks complete and is not.
mkdir -p "$ROOT"
ROOT=$(cd "$ROOT" && pwd)
probe=$(mktemp "$ROOT/.mslCASE.XXXXXX") || exit 1
lower=$(dirname "$probe")/$(basename "$probe" | tr 'A-Z' 'a-z')
collides=no
if [ -e "$lower" ]; then collides=yes; fi
rm -f "$probe"
if [ "$collides" = yes ]; then
    cat >&2 <<EOM
$ROOT is on a case-insensitive filesystem.

Debian ships files whose names differ only in case, and this filesystem cannot
hold both - the tree would come out quietly incomplete. Make a case-sensitive
volume first:

    msl-mkvolume ~/.msl/disk.sparseimage /Volumes/msl

then build into it, e.g. /Volumes/msl/rootfs-debian.
EOM
    exit 1
fi

# The executable that takes -m, not the perl wrapper installed beside it. Same
# search nabi-shell.sh does, and for the same reason: the wrapper's options are
# --root/--strace/--output and it answers -m with "Unknown option: m".
here=$(cd "$(dirname "$0")/.." && pwd)
for cand in ${NABI:-} "$here/out/nabi" "$here/libexec/nabi" \
            /usr/local/libexec/nabi; do
    [ -n "$cand" ] && [ -x "$cand" ] || continue
    if [ "$(head -c 2 "$cand" 2>/dev/null)" = "#!" ]; then continue; fi
    NABI=$cand
    break
done

CACHE=${MSL_CACHE:-$HOME/.msl/cache/$DISTRO-$SUITE-$ARCH}
mkdir -p "$CACHE"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT


# ---------------------------------------------------------------------------
# Prebuilt rootfs archives (fedora, arch)
# ---------------------------------------------------------------------------

# tar drops set-user-ID and set-group-ID when an ordinary account extracts an
# archive, so sudo, su and mount come out as plain 0755 and sudo refuses to run
# at all. The bits are in the archive; this puts them back. Only entries that
# carry one are touched, which is a handful per tree.
restore_setuid_bits() {
    tar -tvf "$1" 2>/dev/null | awk '
        substr($1, 4, 1) ~ /[sS]/ || substr($1, 7, 1) ~ /[sS]/ {
            mode = ""
            if (substr($1, 4, 1) ~ /[sS]/) mode = mode "u+s,"
            if (substr($1, 7, 1) ~ /[sS]/) mode = mode "g+s,"
            sub(/,$/, "", mode)
            if ($0 !~ / -> /) print mode "\t" $NF
        }' |
    while IFS="$(printf '\t')" read -r m f; do
        f=${f#./}
        [ -e "$ROOT/$f" ] && chmod "$m" "$ROOT/$f" 2>/dev/null || true
    done
}

# A file fetched once and kept, checked against a digest before it is trusted.
# A cached copy is only believed after it verifies: a truncated download from an
# earlier run is otherwise indistinguishable from a good one.
fetch_verified() {
    url=$1; out=$2; algo=$3; want=$4
    if [ -f "$out" ] &&
       [ "$(shasum -a "$algo" "$out" 2>/dev/null | cut -d' ' -f1)" = "$want" ]; then
        return 0
    fi
    if [ -f "$out" ] && [ "$algo" = md5 ] &&
       [ "$(md5 -q "$out" 2>/dev/null)" = "$want" ]; then
        return 0
    fi
    echo "    fetching $(basename "$out")"
    curl -fsSL "$url" -o "$out.part"
    if [ "$algo" = md5 ]; then
        got=$(md5 -q "$out.part")
    else
        got=$(shasum -a "$algo" "$out.part" | cut -d' ' -f1)
    fi
    if [ "$got" != "$want" ]; then
        rm -f "$out.part"
        echo "${0##*/}: $(basename "$out") failed its checksum" >&2
        exit 1
    fi
    mv "$out.part" "$out"
}

# Fedora publishes the base system as an OCI image: a layout directory holding
# a manifest and the filesystem layers it names. index.json points at the
# manifest, the manifest lists the layers, and the layers are ordinary tarballs
# applied in order. Nothing here needs a container runtime.
build_oci() {
    echo "==> fetching the $DISTRO $SUITE image index"
    index=$(curl -fsSL "$IMAGES/") ||
        { echo "${0##*/}: cannot reach $IMAGES" >&2; exit 1; }

    case $VARIANT in
        minbase) want='Base-Generic-Minimal' ;;
        *)       want='Base-Generic' ;;
    esac
    # -Minimal also matches the plain pattern, so the standard variant has to
    # exclude it explicitly rather than take whichever sorted first.
    img=$(printf '%s' "$index" |
          grep -oE "Fedora-Container-$want-[0-9.]+-[0-9.]+\.aarch64\.oci\.tar\.xz" |
          { [ "$VARIANT" = minbase ] && cat || grep -v Minimal; } |
          sort -u | head -1)
    sums=$(printf '%s' "$index" |
           grep -oE 'Fedora-Container-[0-9.-]+-aarch64-CHECKSUM' | sort -u | head -1)
    [ -n "$img" ] && [ -n "$sums" ] ||
        { echo "${0##*/}: no $want image for Fedora $SUITE" >&2; exit 1; }

    # The digest comes from the checksum file beside the image, over https.
    # There is no signature check here: Fedora signs these, but with an OpenPGP
    # key and macOS ships no gpgv, so the trust root is TLS - the same
    # compromise the apt path documents.
    want_sha=$(curl -fsSL "$IMAGES/$sums" |
               sed -n "s/^SHA256 ($img) = \\([0-9a-f]*\\)$/\\1/p" | head -1)
    [ -n "$want_sha" ] ||
        { echo "${0##*/}: $img is not in $sums" >&2; exit 1; }

    echo "    $img"
    fetch_verified "$IMAGES/$img" "$CACHE/$img" 256 "$want_sha"

    echo "==> unpacking"
    rm -rf "$work/oci"; mkdir -p "$work/oci"
    tar -xf "$CACHE/$img" -C "$work/oci"

    manifest=$(grep -oE 'sha256:[0-9a-f]{64}' "$work/oci/index.json" |
               head -1 | cut -d: -f2)
    [ -n "$manifest" ] ||
        { echo "${0##*/}: no manifest in the image index" >&2; exit 1; }

    # Everything after "layers" - the config digest appears before it, and
    # taking every digest in the file would apply the config as a layer.
    layers=$(tr -d '\n' < "$work/oci/blobs/sha256/$manifest" |
             sed 's/.*"layers"//' |
             grep -oE 'sha256:[0-9a-f]{64}' | cut -d: -f2)
    [ -n "$layers" ] ||
        { echo "${0##*/}: the manifest lists no layers" >&2; exit 1; }

    for l in $layers; do
        blob=$work/oci/blobs/sha256/$l
        tar -xf "$blob" -C "$ROOT" 2>/dev/null || true
        restore_setuid_bits "$blob"
    done
}

# Arch Linux ARM publishes a plain rootfs tarball, already complete.
build_tar() {
    echo "==> fetching the $DISTRO rootfs"
    want_md5=$(curl -fsSL "$MIRROR/$ARCHIVE.md5" | awk '{print $1; exit}')
    [ -n "$want_md5" ] ||
        { echo "${0##*/}: no checksum for $ARCHIVE" >&2; exit 1; }
    fetch_verified "$MIRROR/$ARCHIVE" "$CACHE/$ARCHIVE" md5 "$want_md5"

    echo "==> unpacking"
    tar -xf "$CACHE/$ARCHIVE" -C "$ROOT" 2>/dev/null || true
    restore_setuid_bits "$CACHE/$ARCHIVE"
}

build_apt() {
# ---------------------------------------------------------------------------
# 1. Resolve
# ---------------------------------------------------------------------------

echo "==> fetching the $DISTRO $SUITE/$ARCH index from $MIRROR"
curl -fsSL "$MIRROR/dists/$SUITE/Release" -o "$work/Release"

# The index's own checksum, from the Release file, so a corrupted or
# substituted Packages is caught before anything is resolved against it.
want_sha=$(awk -v p="main/binary-$ARCH/Packages.gz" '
    /^SHA256:/ { insha = 1; next }
    /^[A-Za-z-]+:/ { insha = 0 }
    insha && $3 == p { print $1; exit }' "$work/Release")
[ -n "$want_sha" ] || { echo "${0##*/}: $SUITE/$ARCH is not in Release" >&2; exit 1; }

curl -fsSL "$MIRROR/dists/$SUITE/main/binary-$ARCH/Packages.gz" -o "$work/Packages.gz"
got_sha=$(shasum -a 256 "$work/Packages.gz" | cut -d' ' -f1)
if [ "$got_sha" != "$want_sha" ]; then
    echo "${0##*/}: Packages.gz does not match Release" >&2
    exit 1
fi
gunzip -c "$work/Packages.gz" > "$work/Packages"

cat > "$work/resolve.awk" <<'AWK'
# Read a Debian Packages index, print the closure of a seed set.
# Emits: <name> <tab> <filename> <tab> <sha256> <tab> <size>
BEGIN { FS = ": " }

function record(   i, n, pv) {
  if (pkg == "") return
  # A package can appear more than once; the first stanza wins, which within a
  # single suite is the only version there is.
  if (pkg in fname) return
  fname[pkg] = filename; sha[pkg] = sha256; sz[pkg] = size
  dep[pkg] = depends; pri[pkg] = priority; ess[pkg] = essential
  # Provides makes a virtual name resolvable. Recorded only if nothing real
  # claims the name, so a real package always beats a provider.
  n = split(provides, pv, /, */)
  for (i = 1; i <= n; i++) {
    gsub(/ *\(.*\)/, "", pv[i]); gsub(/:any$/, "", pv[i]); gsub(/^ +| +$/, "", pv[i])
    if (pv[i] != "" && !(pv[i] in virt)) virt[pv[i]] = pkg
  }
}

/^Package: /  { record(); pkg = $2
                filename = sha256 = size = depends = priority = essential = provides = ""
                next }
/^Filename: / { filename = $2; next }
/^SHA256: /   { sha256 = $2; next }
/^Size: /     { size = $2; next }
/^Priority: / { priority = $2; next }
/^Essential: /{ essential = $2; next }
/^Depends: /     { depends = depends (depends ? ", " : "") $2; next }
/^Pre-Depends: / { depends = depends (depends ? ", " : "") $2; next }
/^Provides: /    { provides = $2; next }

END {
  record()

  # The floor: what the archive marks required or essential. "important" on top
  # is the difference between something dpkg can run in and something a person
  # would recognise as a Debian system.
  for (p in fname)
    if (pri[p] == "required" || ess[p] == "yes" ||
        (important && pri[p] == "important")) want[p] = 1
  n = split(seeds, s, /,/)
  for (i = 1; i <= n; i++)
    if (s[i] != "") want[s[i]] = 1

  # Closure over Depends and Pre-Depends only. Recommends is deliberately not
  # followed.
  changed = 1
  while (changed) {
    changed = 0
    for (p in want) {
      if (p in seen) continue
      seen[p] = 1; changed = 1
      if (!(p in fname)) {
        if (p in virt) { want[virt[p]] = 1; continue }
        printf "unresolved: %s\n", p > "/dev/stderr"
        continue
      }
      na = split(dep[p], alts, /, */)
      for (a = 1; a <= na; a++) {
        # "x | y": take the first alternative the archive can satisfy, which is
        # the one apt calls the default and the one debootstrap picks.
        nb = split(alts[a], opt, / *\| */)
        chosen = ""
        for (b = 1; b <= nb; b++) {
          d = opt[b]
          gsub(/ *\(.*\)/, "", d); gsub(/:any$/, "", d); gsub(/:native$/, "", d)
          gsub(/^ +| +$/, "", d)
          if (d == "") continue
          if (d in fname) { chosen = d; break }
          if (d in virt)  { chosen = virt[d]; break }
        }
        if (chosen != "") want[chosen] = 1
      }
    }
  }

  for (p in want)
    if (p in fname)
      printf "%s\t%s\t%s\t%s\n", p, fname[p], sha[p], sz[p]
}
AWK

important=0
if [ "$VARIANT" = standard ]; then important=1; fi
# ca-certificates and the keyring are not required by anything, but without
# them apt in the finished tree cannot verify or fetch over https - which is
# the first thing anyone will ask it to do.
# sudo is here because the account created in stage 4 is given sudo rights, and
# a sudoers entry without the binary to read it is not a privilege, it is a
# "sudo: command not found". It is Priority: optional in both archives, so
# neither the required floor nor "important" brings it in.
seeds="apt,bash,dpkg,sudo,ca-certificates,$KEYRING"
if [ -n "$EXTRA" ]; then seeds="$seeds,$EXTRA"; fi

echo "==> resolving"
awk -v seeds="$seeds" -v important=$important -f "$work/resolve.awk" \
    "$work/Packages" | sort > "$work/closure"
count=$(wc -l < "$work/closure" | tr -d ' ')
bytes=$(awk -F'\t' '{s += $4} END {print s + 0}' "$work/closure")
echo "    $count packages, $((bytes / 1048576)) MB"

# ---------------------------------------------------------------------------
# 2. Unpack
# ---------------------------------------------------------------------------

echo "==> downloading"
n=0
while IFS="$(printf '\t')" read -r pkg file sha size; do
    n=$((n + 1))
    out="$CACHE/$(basename "$file")"
    # A cached file is trusted only after it checks out; a truncated download
    # from a previous run is otherwise indistinguishable from a good one.
    if [ -f "$out" ] && [ "$(shasum -a 256 "$out" | cut -d' ' -f1)" = "$sha" ]; then
        continue
    fi
    curl -fsSL "$MIRROR/$file" -o "$out.part"
    got=$(shasum -a 256 "$out.part" | cut -d' ' -f1)
    if [ "$got" != "$sha" ]; then
        rm -f "$out.part"
        echo "${0##*/}: $pkg failed its checksum" >&2
        exit 1
    fi
    mv "$out.part" "$out"
    if [ $((n % 20)) -eq 0 ]; then echo "    $n/$count"; fi
done < "$work/closure"

echo "==> unpacking"
mkdir -p "$ROOT/var/lib/dpkg/info" "$ROOT/var/lib/dpkg/updates" \
         "$ROOT/var/lib/dpkg/triggers" "$ROOT/var/lib/apt/lists/partial" \
         "$ROOT/var/cache/apt/archives/partial" "$ROOT/etc/apt/apt.conf.d" \
         "$ROOT/etc/apt/preferences.d" "$ROOT/etc/apt/sources.list.d" \
         "$ROOT/var/log/apt" "$ROOT/run" "$ROOT/var/tmp" "$ROOT/tmp" \
         "$ROOT/proc" "$ROOT/sys" "$ROOT/dev"
chmod 1777 "$ROOT/tmp" "$ROOT/var/tmp"

status="$work/status"
: > "$status"
n=0
while IFS="$(printf '\t')" read -r pkg file sha size; do
    n=$((n + 1))
    deb="$CACHE/$(basename "$file")"
    d="$work/x"; rm -rf "$d"; mkdir -p "$d"
    ( cd "$d" && ar x "$deb" )

    data=$(ls "$d"/data.tar.* 2>/dev/null | head -1)
    ctrl=$(ls "$d"/control.tar.* 2>/dev/null | head -1)
    [ -n "$data" ] && [ -n "$ctrl" ] || { echo "    ! $pkg is not a .deb"; continue; }

    tar -xf "$data" -C "$ROOT" 2>/dev/null || true

    mkdir -p "$d/c" && tar -xf "$ctrl" -C "$d/c" 2>/dev/null || true
    [ -f "$d/c/control" ] || continue

    arch=$(awk '/^Architecture:/ {print $2; exit}' "$d/c/control")
    ma=$(awk '/^Multi-Arch:/ {print $2; exit}' "$d/c/control")
    # Multi-Arch: same packages are keyed name:arch, everything else by name -
    # that is how dpkg names both the status entry and these files.
    lname=$pkg
    if [ "$ma" = same ]; then lname="$pkg:$arch"; fi

    # The file list. Without it `dpkg -L` and `dpkg -S` answer nothing and every
    # query warns that the package has no files installed. The data.tar member
    # names are exactly that list, once ./ becomes / and the trailing slash on
    # directories is dropped.
    tar -tf "$data" 2>/dev/null |
        sed -e 's|^\./$|/.|' -e 's|^\./|/|' -e 's|\(.\)/$|\1|' \
        > "$ROOT/var/lib/dpkg/info/$lname.list"

    # macOS drops set-user-ID and set-group-ID when a non-root account extracts
    # an archive, so sudo, su, mount and the rest come out as plain 0755 and
    # sudo refuses to run at all ("must be owned by uid 0 and have the setuid
    # bit set"). The bits are in the archive; they are put back here. Only
    # entries that carry one are touched, which is a handful per tree.
    tar -tvf "$data" 2>/dev/null | awk '
        substr($1, 4, 1) == "s" || substr($1, 7, 1) == "s" ||
        substr($1, 4, 1) == "S" || substr($1, 7, 1) == "S" {
            mode = ""
            if (substr($1, 4, 1) ~ /[sS]/) mode = mode "u+s,"
            if (substr($1, 7, 1) ~ /[sS]/) mode = mode "g+s,"
            sub(/,$/, "", mode)
            # The name is the last field; a symlink prints "name -> target",
            # and a symlink cannot carry these bits anyway.
            if ($0 !~ / -> /) print mode "\t" $NF
        }' |
    while IFS="$(printf '\t')" read -r m f; do
        f=${f#./}
        [ -e "$ROOT/$f" ] && chmod "$m" "$ROOT/$f" 2>/dev/null || true
    done

    # The maintainer scripts and the md5sums, which the ISO-based builder never
    # laid down - so nothing could be configured afterwards and `dpkg --audit`
    # reported every package as missing its md5sums.
    for m in "$d"/c/*; do
        b=$(basename "$m")
        case $b in
            control|conffiles) continue ;;
        esac
        [ -f "$m" ] || continue
        cp "$m" "$ROOT/var/lib/dpkg/info/$lname.$b"
        case $b in
            preinst|postinst|prerm|postrm|config)
                chmod 755 "$ROOT/var/lib/dpkg/info/$lname.$b" ;;
        esac
    done
    if [ -f "$d/c/conffiles" ]; then
        cp "$d/c/conffiles" "$ROOT/var/lib/dpkg/info/$lname.conffiles"
    fi

    # "unpacked", not "installed": the files are there and nothing has been
    # configured. Stage 3 is what turns this into "installed", by running the
    # postinst that says so.
    echo "Package: $pkg"                >> "$status"
    echo "Status: install ok unpacked"  >> "$status"
    awk 'BEGIN{d=0} /^$/{d=1} d==0 && !/^Package:/ {print}' "$d/c/control" >> "$status"
    echo "" >> "$status"

    if [ $((n % 20)) -eq 0 ]; then echo "    $n/$count"; fi
done < "$work/closure"

cp "$status" "$ROOT/var/lib/dpkg/status"
: > "$ROOT/var/lib/dpkg/available"

# usrmerge: the compatibility symlinks base-files normally provides.
for l in bin sbin lib; do
    [ -e "$ROOT/$l" ] || ln -s "usr/$l" "$ROOT/$l" 2>/dev/null || true
done
[ -e "$ROOT/lib64" ] || ln -s usr/lib "$ROOT/lib64" 2>/dev/null || true

}

# ---------------------------------------------------------------------------
# Lay the tree down, by whichever route this distro takes
# ---------------------------------------------------------------------------

case $FAMILY in
    apt) build_apt ;;
    oci) build_oci ;;
    tar) build_tar ;;
esac

# An entry that denies its own owner cannot be reached by anybody except real
# root, and nabi is not real root: it performs every access as the ordinary
# account that started it, so the guest's root cannot reach one either. A
# published image has a handful - Fedora ships /etc/shadow and /etc/gshadow as
# mode 0000 and /root as dr-xr-x---, so shadow-utils stops at "useradd: cannot
# open /etc/gshadow" and root cannot write its own home.
#
# Giving the owner back read on files and write on directories is enough, and
# touches about a dozen entries in either image. What the guest sees changes -
# 0000 becomes 0600, 0550 becomes 0750 - which nothing checks, and which still
# keeps both to root.
#
# The general answer is to record the guest's mode beside its owner, the way
# ownership already is, so the host mode can stay permissive while the guest
# sees the real one. That is a larger piece of work; it is written up in
# PORTING-arm64.md rather than started here.
find "$ROOT" -type d ! -perm -u+w -exec chmod u+w {} + 2>/dev/null || true
find "$ROOT" -type f ! -perm -u+r -exec chmod u+r {} + 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3. Configure, inside NABI
# ---------------------------------------------------------------------------

# /etc/passwd and /etc/group are deliberately NOT seeded here. base-passwd's
# postinst installs its masters only when they are absent, so a placeholder
# survives stage 3 as the whole account database - which leaves no `utmp`
# group, and base-files' own postinst then stops on `chown root:utmp`. Letting
# the postinst own the file is the entire point of stage 3.
mkdir -p "$ROOT/root" "$ROOT/usr/local"

if [ "$FAMILY" = apt ]; then
cat > "$ROOT/etc/apt/sources.list" <<EOS
deb $MIRROR $SUITE main
deb $MIRROR $SUITE-updates main
$SECURITY
EOS
fi

# Replaced rather than written through. Arch ships /etc/resolv.conf as a symlink
# to /run/systemd/resolve/resolv.conf, which nothing here creates, so a redirect
# follows the link into a directory that does not exist and fails with ENOENT -
# about a file that is plainly there. The same goes for the others: what is
# wanted is a real file, not an edit to whatever a runtime directory would have
# held.
rm -f "$ROOT/etc/resolv.conf" "$ROOT/etc/nsswitch.conf" \
      "$ROOT/etc/hostname" "$ROOT/etc/hosts"

# Taken from the host, so the guest resolves the way the machine does rather
# than against a hardcoded public resolver.
if [ -s /etc/resolv.conf ]; then
    grep -E '^(nameserver|search|domain|options)' /etc/resolv.conf \
        > "$ROOT/etc/resolv.conf" 2>/dev/null || true
fi
[ -s "$ROOT/etc/resolv.conf" ] ||
    printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > "$ROOT/etc/resolv.conf"

cat > "$ROOT/etc/nsswitch.conf" <<'EOS'
passwd:         files
group:          files
shadow:         files
gshadow:        files

hosts:          files dns
networks:       files

protocols:      db files
services:       db files
ethers:         db files
rpc:            db files
EOS

# The guest gets the host's hostname from uname, so /etc/hosts has to know it
# or every lookup of the machine's own name fails - sudo says "unable to
# resolve host" on each invocation, and it is only a warning until something
# treats it as an error.
HOSTNAME=$(hostname -s 2>/dev/null || echo msl)
# pacman 7 confines its download helper with Landlock and drops to an `alpm`
# user to do it. There is no kernel here to provide Landlock, so it fails at the
# first step - "restricting filesystem access failed because Landlock is not
# supported by the kernel" - and refuses to fetch anything at all.
#
# Turning the sandbox off gives up nothing that was protecting anything: it
# exists to confine a download helper running as root on a real kernel, and the
# guest's root is emulated - the host process stays the ordinary account that
# started nabi whichever uid the guest believes it has. The line is added under
# [options] rather than appended, which would land it in the last repository
# section instead.
if [ "$FAMILY" = tar ] && [ -f "$ROOT/etc/pacman.conf" ] &&
   ! grep -q '^DisableSandbox' "$ROOT/etc/pacman.conf"; then
    awk '{ print }
         /^\[options\]/ && !done {
             print "# msl: no Landlock under NABI, and the guest root it would"
             print "# confine is emulated - see the notes in msl-mkrootfs."
             print "DisableSandbox"
             done = 1
         }' "$ROOT/etc/pacman.conf" > "$ROOT/etc/pacman.conf.msl" &&
        mv "$ROOT/etc/pacman.conf.msl" "$ROOT/etc/pacman.conf"
fi

printf '%s\n' "$HOSTNAME" > "$ROOT/etc/hostname"
printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n' "$HOSTNAME" > "$ROOT/etc/hosts"

if [ -z "${NABI:-}" ] || [ ! -x "${NABI:-}" ]; then
    cat >&2 <<EOM

==> no nabi executable found, so the tree is unpacked but not configured.

    Build one with 'make ARCH=arm64' or install with 'sudo make install',
    then finish with:

      msl $ROOT dpkg --configure -a
EOM
    exit 0
fi

if [ "$FAMILY" = apt ]; then
echo "==> configuring (dpkg --configure -a, under NABI)"
# Twice, because the order dpkg picks from a cold tree is not always one that
# works. base-files' postinst runs `chown root:utmp`, and if it is configured
# before base-passwd - which is the package that installs the group file that
# has a utmp in it - it stops on a group that does not exist yet. Nothing is
# wrong with either package; the second pass finds base-passwd already done and
# base-files now able to finish. --force-depends is what lets the first pass get
# far enough to make the second one useful.
#
# Anything still broken after two passes is a real failure and is counted below
# rather than hidden.
configure() {
    env -i TERM="${TERM:-xterm}" HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        DEBIAN_FRONTEND=noninteractive \
        "$NABI" -m "$ROOT" /bin/bash -lc \
        'dpkg --configure -a --force-depends 2>&1' || true
}
configure > /dev/null 2>&1
configure | tail -20
fi

# ---------------------------------------------------------------------------
# 4. An account to be, inside the guest
# ---------------------------------------------------------------------------
#
# Named after whoever is running this, because the point of it is to be your
# account rather than root's. It is created with the distro's own useradd, so
# /etc/shadow, the home directory and the skeleton files are laid down the way
# the distro means them to be - none of which this script could do from outside.
#
# uid 1000, not the host's uid: the host account is already what the guest sees
# as root (see struct cred), so giving this user the same number would make its
# files read back as root's and defeat the whole exercise.
#
# NOPASSWD, because there is no password to type. The account has no usable
# password by construction, and PAM cannot check one here in any case; a sudo
# that always refuses would be worse than no sudo. The host account is the real
# security boundary, and it is unchanged either way - the guest's root is an
# emulation, not a way out.
GUEST_USER=${MSL_USER:-$(id -un)}
case $GUEST_USER in
    root|''|*[!a-zA-Z0-9._-]*)
        echo "==> skipping the guest account: '$GUEST_USER' is not a usable name"
        GUEST_USER=
        ;;
esac

if [ -n "$GUEST_USER" ]; then
    echo "==> creating $GUEST_USER (uid 1000, sudo)"
    # Written to a file and run, rather than passed as a quoted argument: the
    # script has to survive this shell, bash -lc and the guest's own quoting,
    # and one layer of that going wrong is silent.
    #
    # /var/tmp, not /tmp: /tmp is one of NABI's host passthrough prefixes, so
    # the guest's /tmp is the host's and a file written to $ROOT/tmp is not
    # where the guest will look for it.
    cat > "$ROOT/var/tmp/msl-adduser.sh" <<EOS
#!/bin/bash
set -e
u=$GUEST_USER
# shadow-utils refuses to add a user when these are missing, and a minimal
# container image ships neither: Fedora's stops at "useradd: cannot open
# /etc/gshadow" and no account is made at all.
for f in /etc/shadow /etc/gshadow; do
    [ -e "\$f" ] || { : > "\$f"; chmod 0000 "\$f"; }
done
sh=/bin/bash; [ -x /bin/bash ] || sh=/bin/sh
# uid 1000 is the conventional first account, but some images already have
# one there - Arch ships one called alarm. Asked for, and given up on rather
# fought over: which number it lands on does not matter to anything here.
id -u "\$u" >/dev/null 2>&1 ||
    useradd -m -u 1000 -s "\$sh" -c "\$u" "\$u" 2>/dev/null ||
    useradd -m -s "\$sh" -c "\$u" "\$u"
# sudo is the group both Debian and Ubuntu grant admin rights to.
for g in sudo wheel adm users; do
    getent group "\$g" >/dev/null 2>&1 && usermod -aG "\$g" "\$u" || true
done
# Locked rather than empty: an empty password would let anything that does
# check one straight in.
passwd -l "\$u" >/dev/null 2>&1 || true
mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "\$u" > /etc/sudoers.d/"\$u"
chmod 0440 /etc/sudoers.d/"\$u"

# pam_limits is taken out of sudo's session stack.
#
# With it in, sudo stops before running anything: pam_open_session comes back
# PAM_PERM_DENIED. Every getrlimit and setrlimit NABI is asked for during that
# call succeeds, so the refusal is internal to the module and is not yet
# understood. Marking it "optional" is not enough - the call then hangs instead,
# so it is the module running at all that is the problem, not its return code.
#
# Nothing is lost by removing it. There is no kernel here to enforce a resource
# limit, and Debian and Ubuntu both ship limits.conf entirely commented out, so
# the module has nothing to apply even where it works. The line is commented
# rather than deleted, and says why, so it can be put back.
if [ -f /etc/pam.d/sudo ] && grep -q '^session.*pam_limits' /etc/pam.d/sudo; then
    sed -i 's|^\(session.*pam_limits.so.*\)$|# msl: disabled, see the note at the end of this file\n# \1|' \
        /etc/pam.d/sudo
    cat >> /etc/pam.d/sudo <<'PAMNOTE'

# msl: pam_limits was commented out when this rootfs was built. Under NABI it
# returns PAM_PERM_DENIED, and as a required module that stops sudo running at
# all; marking it optional makes the call hang instead. It has nothing to do
# here in any case - there is no kernel to enforce a resource limit, and
# limits.conf ships empty. Uncomment it to get the original behaviour back.
PAMNOTE
fi
id "\$u"
EOS
    chmod 755 "$ROOT/var/tmp/msl-adduser.sh"
    env -i TERM="${TERM:-xterm}" HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        DEBIAN_FRONTEND=noninteractive MSL_ROOT=1 \
        "$NABI" -m "$ROOT" /bin/bash -lc /var/tmp/msl-adduser.sh 2>&1 |
        sed 's/^/    /'
    rm -f "$ROOT/var/tmp/msl-adduser.sh"
fi

# ---------------------------------------------------------------------------
# 5. Package lists
# ---------------------------------------------------------------------------
#
# Without this the tree has a working apt and nothing for it to work on:
# `apt install gcc` answers "Unable to locate package gcc", which reads like a
# missing package rather than an empty index. Fetching it here means the tree
# is usable the moment it is built.
#
# Best-effort: a machine that is offline, or behind a proxy this does not know
# about, should still get a rootfs. `apt update` is one command away.
echo "==> fetching package lists"
case $FAMILY in
    apt) refresh='apt-get update' ;;
    oci) refresh='dnf -q makecache || dnf5 -q makecache' ;;
    tar) refresh='pacman -Sy --noconfirm' ;;
esac
env -i TERM="${TERM:-xterm}" HOME=/root PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    DEBIAN_FRONTEND=noninteractive MSL_ROOT=1 \
    "$NABI" -m "$ROOT" /bin/bash -lc "$refresh" 2>&1 |
    tail -3 | sed 's/^/    /' || true

echo "==> done: $ROOT"
# How many packages, asked the way this distro counts them. dpkg reads its own
# status file from outside; rpm and pacman keep databases only their own tools
# can open, so those are asked from within the guest.
case $FAMILY in
    apt)
        echo "    $(grep -c '^Package:' "$ROOT/var/lib/dpkg/status") packages"
        # grep -c exits 1 when it counts nothing, which is the good case here -
        # so the count is taken with `|| true` inside the guest rather than
        # guarded outside, where the failure would be indistinguishable from
        # not being able to ask.
        left=$(env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
            "$NABI" -m "$ROOT" /bin/bash -lc \
            "dpkg-query -f '\${Status}\n' -W 2>/dev/null | grep -vc '^install ok installed$' || true" \
            2>/dev/null | tr -dc '0-9')
        [ -n "$left" ] || left='?'
        echo "    $left not fully configured"
        ;;
    *)
        n=$(env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
            "$NABI" -m "$ROOT" /bin/bash -lc \
            "{ rpm -qa 2>/dev/null || pacman -Qq 2>/dev/null; } | wc -l" \
            2>/dev/null | tr -dc '0-9')
        [ -n "$n" ] && [ "$n" != 0 ] && echo "    $n packages"
        ;;
esac
echo
if [ -n "$GUEST_USER" ]; then
    if [ -x "$ROOT/usr/bin/sudo" ] || [ -x "$ROOT/bin/sudo" ]; then
        echo "    log in as $GUEST_USER; sudo works without a password"
    else
        # Only Debian and Ubuntu get sudo seeded, because only there can a
        # package be added while the tree is being built. A published image
        # brings whatever it brings, and neither Fedora's minimal container nor
        # Arch's base includes sudo - so say what is true rather than repeat a
        # promise that belongs to the other two.
        echo "    log in as $GUEST_USER; no sudo in this image - use su for root"
    fi
fi
echo
echo "    msl $ROOT"
